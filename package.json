{
  "name": "melodias",
  "private": true,
  "version": "0.1.0",
  "description": "Personal melody studio in the browser: piano roll with scale snapping, notes colored by scale degree, Tone.js playback, MIDI input and a local library.",
  "license": "MIT",
  "author": "Erick Bonruque",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErickBonruque/melodias.git"
  },
  "homepage": "https://github.com/ErickBonruque/melodias#readme",
  "keywords": [
    "music",
    "melody",
    "piano-roll",
    "music-theory",
    "tonejs",
    "web-audio",
    "web-midi",
    "react",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:visual": ".venv/bin/python .claude/skills/webapp-testing/scripts/with_server.py --server \"npm run dev\" --port 5173 -- .venv/bin/python tests/visual/run_all.py"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@spotify/basic-pitch": "^1.0.1",
    "abcjs": "^6.7.1",
    "dexie": "^4.4.6",
    "pitchy": "^4.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tonal": "6.4.2",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
